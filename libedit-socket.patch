--- a/src/terminal.c
+++ b/src/terminal.c
@@ -84,0 +85 @@
+#include "read.h"
@@ -931,0 +933,19 @@
+	/* Socket editors get live session dimensions through EL_GETENV. */
+	if ((el->el_flags & NO_TTY) && el_read_getfn(el) != EL_BUILTIN_GETCFN) {
+		const char *width = (el->el_getenv)("COLUMNS");
+		const char *height = (el->el_getenv)("LINES");
+		char *end;
+		long value;
+		if (width) {
+			value = strtol(width, &end, 10);
+			if (!*end && value >= 2 && value <= 9999)
+				*cols = (int)value;
+		}
+		if (height) {
+			value = strtol(height, &end, 10);
+			if (!*end && value >= 1 && value <= 9999)
+				*lins = (int)value;
+		}
+		return Val(T_co) != *cols || Val(T_li) != *lins;
+	}
+
@@ -964,0 +985,8 @@
+	int socket_editor = (el->el_flags & NO_TTY) &&
+	    el_read_getfn(el) != EL_BUILTIN_GETCFN;
+	/* The embedding terminal reflows wrapped cells before notifying the editor. */
+	if (socket_editor && cols >= 2 && Val(T_co) >= 2) {
+		size_t offset = (size_t)cur.v * (size_t)Val(T_co) + (size_t)cur.h;
+		cur.v = (int)(offset / (size_t)cols);
+		cur.h = (int)(offset % (size_t)cols);
+	}
